---
// src/pages/about.astro
// About Us page strictly adhering to Section 1 & Section 7.8 brand and legal rules
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const seoTitle = 'About Us & Engineering Philosophy | Web Harbor Solutions';
const seoDesc = 'We built Web Harbor Solutions to end predatory web agency pricing. We prove our value in code before we ever send an invoice with our $0 upfront prototype model.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>OUR ENGINEERING PHILOSOPHY</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
          We Built Web Harbor Solutions to End Predatory Web Agency Pricing.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Local businesses shouldn't have to gamble $5,000 on slow, fragile WordPress websites. We prove our value in code before we ever send an invoice.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Story & Mission (2-Column Editorial Layout) -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left Editorial Text -->
        <div class="space-y-6" data-reveal>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
            <span>THE ORIGIN</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
            Why We Inverted the Entire Web Agency Business Model
          </h2>

          <div class="space-y-4 text-base text-slate-300 leading-relaxed">
            <p>
              For decades, local service businesses—from dental practices and HVAC contractors to litigation firms and aesthetic clinics—have been forced to accept an unfair bargain. Agencies charge $3,000 to $10,000 upfront just to open a Figma file, leaving business owners bearing 100% of the financial risk.
            </p>
            <p>
              Months later, the client receives a clunky WordPress site running 40 outdated plugins that takes 8 seconds to load on mobile phones. When simple updates are needed—like updating a phone number or adding a seasonal promotion—the agency sends a $150/hr invoice and takes two weeks to reply.
            </p>
            <p>
              We founded Web Harbor Solutions on a radical principle: <strong class="text-white">proof before payment</strong>. By replacing bloated database CMSs with modern Edge Static architecture (Astro, TypeScript, and Cloudflare Pages), we eliminated 90% of agency overhead. We build your entire website preview first on a live staging link. You only pay if you love the result.
            </p>
          </div>
        </div>

        <!-- Right Visual Spec Card -->
        <div class="spotlight-card rounded-3xl bg-slate-900/60 border border-white/10 p-8 sm:p-10 backdrop-blur-xl shadow-2xl space-y-6" data-reveal>
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <span class="text-xs font-mono uppercase tracking-wider text-sky-400 font-semibold">Web Harbor Architecture</span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-mono">Verified SLA</span>
          </div>

          <div class="space-y-4 text-sm">
            <div class="flex justify-between items-center py-2 border-b border-white/[0.04]">
              <span class="text-slate-400">Upfront Prototype Cost:</span>
              <span class="text-emerald-400 font-mono font-bold">$0 (Zero Obligation)</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/[0.04]">
              <span class="text-slate-400">Launch Setup Fee:</span>
              <span class="text-white font-mono font-bold">$100 (Only Upon Approval)</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/[0.04]">
              <span class="text-slate-400">All-Inclusive Management:</span>
              <span class="text-sky-400 font-mono font-bold">$99 / month</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/[0.04]">
              <span class="text-slate-400">Included Monthly Edits:</span>
              <span class="text-white font-mono font-bold">Up to 3 Edits / Month</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/[0.04]">
              <span class="text-slate-400">Guaranteed Response SLA:</span>
              <span class="text-white font-mono font-bold">Within 12 Business Hours</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-slate-400">Contract Lock-In:</span>
              <span class="text-emerald-400 font-mono font-bold">Month-to-Month (Cancel Anytime)</span>
            </div>
          </div>

          <div class="pt-4 border-t border-white/[0.08]">
            <a
              href="/contact"
              class="magnetic-btn w-full py-3.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm flex items-center justify-center gap-2 transition-all text-center"
            >
              <span>Experience Our Zero-Risk Model →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Core Engineering Tenets -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>OUR OPERATING PRINCIPLES</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.15]">
          The Three Engineering Tenets We Live By
        </h2>
        <p class="text-slate-400 text-base mt-3">
          Every decision we make as an agency aligns with these three non-negotiables.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <!-- Tenet 1 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-400/20 flex items-center justify-center text-sky-400 font-mono font-bold text-lg">
              01
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Proof Before Payment
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              We never ask you to trust sales pitches or wireframes. We build your complete, custom specification demo first. If you don't love it, you pay $0 and walk away.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-sky-400 font-mono border-t border-white/[0.06]">
            100% Free Spec Demo
          </div>
        </div>

        <!-- Tenet 2 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono font-bold text-lg">
              02
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Speed Is a Conversion Multiplier
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Every second of delay costs local businesses up to 10% of their mobile leads. We enforce a 95–100 PageSpeed standard with pre-rendered edge code that loads in under 0.5s.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-emerald-400 font-mono border-t border-white/[0.06]">
            95–100 Mobile Benchmark
          </div>
        </div>

        <!-- Tenet 3 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-mono font-bold text-lg">
              03
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Relentless Ongoing Support
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              We don't abandon you after launch. Our 12-hour response SLA and 3 included monthly edits mean your website stays fresh, modern, and high-converting year-round.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-indigo-400 font-mono border-t border-white/[0.06]">
            12-Hour SLA Response
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership & Direct Accountability Card -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="spotlight-card rounded-3xl bg-slate-900/60 border border-white/10 p-8 sm:p-12 backdrop-blur-xl shadow-2xl space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
          <span>LEADERSHIP &amp; ACCOUNTABILITY</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
          Direct Engineering Accountability
        </h2>

        <p class="text-slate-300 text-base leading-relaxed">
          At Web Harbor Solutions, you work directly with experienced software engineers who build and maintain your code—never junior offshore contractors or layers of account managers.
        </p>

        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="text-lg font-bold text-white">Abdul Mateen, Founder</div>
            <div class="text-sm text-sky-400 font-mono mt-0.5">Engineering &amp; Client Architecture</div>
            <div class="text-xs text-slate-400 mt-1">Leading our web development and edge infrastructure team.</div>
          </div>
          <div>
            <a
              href="mailto:webharborsolutions@gmail.com"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono border border-white/10 transition-colors"
            >
              <span>webharborsolutions@gmail.com</span>
            </a>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed">
          Have questions about an upcoming build or architecture? We guarantee a direct, human response within 12 business hours.
        </p>
      </div>
    </div>
  </section>

  <!-- Bottom Conversion Banner -->
  <CtaBanner />
</BaseLayout>
