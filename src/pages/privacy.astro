---
// src/pages/privacy.astro
// Privacy Policy strictly adhering to Section 1 & Section 7.10
import BaseLayout from '../layouts/BaseLayout.astro';

const seoTitle = 'Privacy Policy | Web Harbor Solutions';
const seoDesc = 'Privacy policy and data governance disclosures for Web Harbor Solutions. Covers form submissions, cookie-free analytics, and Cloudflare edge security.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <main class="py-20 lg:py-28 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto p-8 sm:p-14 rounded-3xl bg-slate-900/60 border border-white/[0.08] shadow-2xl backdrop-blur-xl space-y-10 text-white relative overflow-hidden">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
            <span>DATA GOVERNANCE</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">Privacy Policy</h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-2 font-mono">Last Updated: October 2026 • Privacy-First Edge Infrastructure</p>
        </div>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">1. Overview</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Web Harbor Solutions ("we," "our," or "us") operates <code class="text-sky-400 font-mono text-xs bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/20">webharborsolutions.com</code>. We provide modern web engineering, managed edge hosting, and ongoing digital maintenance for local service businesses. We respect your privacy and are committed to transparent, cookie-free data practices.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">2. Information We Collect</h2>
          <ul class="space-y-2 text-sm sm:text-base text-slate-300 leading-relaxed list-disc list-inside">
            <li><strong>Contact Form Inquiries:</strong> When you submit a request for a $0 Live Spec Demo or contact our team, we collect your name, business name, work email address, phone number, website URL, and project notes.</li>
            <li><strong>Publicly Available Commercial Data:</strong> To architect your custom live prototype before payment, our engineering team inspects publicly available information such as your existing business website, Google Maps listing, publicly posted service menus, and public reviews.</li>
            <li><strong>Edge Infrastructure &amp; Security Logs:</strong> Our edge hosting provider (Cloudflare) records standard, anonymized network connection telemetry (IP address, user agent, requested URL, and timestamp) solely for DDoS mitigation, bot prevention, and network routing.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">3. Privacy-First &amp; Cookie-Free Analytics</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            We do not use invasive third-party cross-site advertising cookies or tracking pixels. Any traffic metrics collected are aggregated, cookieless, and respect global Do Not Track (DNT) headers.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">4. How We Use Your Data</h2>
          <ul class="space-y-2 text-sm sm:text-base text-slate-300 leading-relaxed list-disc list-inside">
            <li>To engineer, host, and deliver your custom working website prototype on a private staging link.</li>
            <li>To send you the preview link and communicate revisions within our guaranteed 12-hour response SLA.</li>
            <li>To manage DNS cutover, custom domain registration, and ongoing monthly technical maintenance upon client approval.</li>
            <li>We do not sell, rent, monetize, or trade your contact or business data to any third party or marketing broker.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">5. Data Retention &amp; Security</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            We maintain strict access controls and encrypted communication channels. Inbound demo requests and project notes are retained only as long as necessary to service your inquiry or active subscription. You may request permanent deletion of your submission records at any time.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">6. Direct Privacy Contact</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            For questions or requests concerning your data, please contact our team directly:
          </p>
          <div class="p-6 rounded-2xl bg-slate-950/70 border border-white/10 text-xs sm:text-sm text-slate-300 space-y-1.5 font-mono">
            <p><strong class="text-white">Web Harbor Solutions</strong></p>
            <p>Direct Email: <a href="mailto:webharborsolutions@gmail.com" class="text-sky-400 hover:underline">webharborsolutions@gmail.com</a></p>
            <p>Guaranteed Response: Within 12 business hours</p>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
