---
// src/pages/index.astro
// Homepage of Web Harbor Solutions strictly following Section 7.3
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import IndustryBlueprintTable from '../components/IndustryBlueprintTable.astro';
import CtaBanner from '../components/CtaBanner.astro';

const seoTitle = 'Web Harbor Solutions | See Your New Website Live Before You Pay a Single Dollar';
const seoDesc = 'Most agencies demand $3,000 upfront. We build your complete, tailored website first for $0 upfront. Love it? Launch for $100 setup + $99/mo. If not, pay $0.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <!-- Section 1: Hero Section (Split 12-Col Layout Over the 3D Canvas) -->
  <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left 7 Cols -->
        <div class="lg:col-span-7 space-y-6" data-reveal>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
            <span>THE ZERO-RISK WEB AGENCY</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
            See Your New Website Live Before You Pay a Single Dollar.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            Most agencies demand $3,000 upfront for wireframes and empty promises. We build your complete, tailored website first. If you love it, we launch it for $100 setup + $99/mo. If you don't, you pay nothing.
          </p>

          <!-- Dual CTAs -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="/contact"
              class="magnetic-btn inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-base shadow-xl shadow-sky-500/25 transition-all"
            >
              <span>Claim Your Free Demo Website →</span>
            </a>
            <a
              href="/portfolio"
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-white font-semibold text-base transition-all"
            >
              <span>Explore Industry Blueprints</span>
            </a>
          </div>

          <!-- Trust Micro-Bar -->
          <div class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-400 font-mono">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>5–7 Day Turnaround</span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>No Long-Term Contracts</span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>100% Free Spec Demo</span>
            </span>
          </div>
        </div>

        <!-- Right 5 Cols: Live Performance & Telemetry Console Card -->
        <div class="lg:col-span-5" data-reveal>
          <div class="spotlight-card rounded-3xl bg-slate-900/60 border border-white/10 p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-6">
            <!-- Console Header -->
            <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-semibold">Live Telemetry Console</span>
              </div>
              <span class="text-[11px] font-mono text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded border border-sky-400/20">
                EDGE STATIC
              </span>
            </div>

            <!-- Lighthouse 4-Gauge Metric Grid -->
            <div>
              <div class="text-xs font-mono uppercase text-slate-400 mb-3">Google Lighthouse Production Score</div>
              <div class="grid grid-cols-4 gap-2 text-center">
                <div class="p-2.5 rounded-xl bg-white/[0.02] border border-emerald-500/20">
                  <div class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono tabular-nums">99</div>
                  <div class="text-[10px] text-slate-400 font-mono uppercase mt-1">Perf</div>
                </div>
                <div class="p-2.5 rounded-xl bg-white/[0.02] border border-emerald-500/20">
                  <div class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono tabular-nums">100</div>
                  <div class="text-[10px] text-slate-400 font-mono uppercase mt-1">Access</div>
                </div>
                <div class="p-2.5 rounded-xl bg-white/[0.02] border border-emerald-500/20">
                  <div class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono tabular-nums">100</div>
                  <div class="text-[10px] text-slate-400 font-mono uppercase mt-1">Best Prac</div>
                </div>
                <div class="p-2.5 rounded-xl bg-white/[0.02] border border-emerald-500/20">
                  <div class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono tabular-nums">100</div>
                  <div class="text-[10px] text-slate-400 font-mono uppercase mt-1">SEO</div>
                </div>
              </div>
            </div>

            <!-- Telemetry Metrics List -->
            <div class="space-y-3 pt-2 text-xs font-mono border-t border-white/[0.08]">
              <div class="flex justify-between items-center">
                <span class="text-slate-400">First Contentful Paint (FCP):</span>
                <span class="text-emerald-400 font-bold tabular-nums">0.4s</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Cloudflare Edge Network:</span>
                <span class="text-sky-400 font-bold">Active (300+ Cities)</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Database Attack Surface:</span>
                <span class="text-emerald-400 font-bold">Zero (Static Output)</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-slate-400">Upfront Financial Risk:</span>
                <span class="text-emerald-400 font-bold">$0 Verified</span>
              </div>
            </div>

            <!-- System Status Indicator -->
            <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs text-slate-400">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Sub-Second TTFB Guaranteed</span>
              </span>
              <a href="/services" class="text-sky-400 hover:text-sky-300 font-medium">
                View Architecture →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: The Problem with Traditional Web Agencies -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-500/10 border border-rose-400/20 text-rose-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span>
          <span>WHY WE CHANGED THE MODEL</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.15]">
          Local business owners have been burned by outdated agency models for decades.
        </h2>
        <p class="text-slate-400 text-base mt-4">
          The traditional agency model transfers 100% of the risk to you. Here is why local businesses are ditching it for Web Harbor.
        </p>
      </div>

      <!-- 3 Equal-Height Spotlight Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <!-- Card 1 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 font-mono font-bold text-lg">
              01
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Massive Upfront Risk <span class="text-rose-400 font-mono text-base block font-normal mt-1">($3,000 – $7,000)</span>
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Agencies charge $3,000 to $7,000 before writing a single line of code. You take 100% of the financial risk on empty wireframes and vague timelines.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-slate-400 border-t border-white/[0.06]">
            Web Harbor: $0 Upfront Spec Prototype
          </div>
        </div>

        <!-- Card 2 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-mono font-bold text-lg">
              02
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Forgotten After Launch <span class="text-amber-400 font-mono text-base block font-normal mt-1">($150/hr Bills)</span>
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Once delivered, traditional agencies disappear. Need a menu update, pricing tweak, or phone number change? Expect a $150/hr invoice and a two-week wait.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-slate-400 border-t border-white/[0.06]">
            Web Harbor: 3 Monthly Edits Included at $0 Extra
          </div>
        </div>

        <!-- Card 3 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 font-mono font-bold text-lg">
              03
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Bloated &amp; Broken Code <span class="text-rose-400 font-mono text-base block font-normal mt-1">(8.0s Load Times)</span>
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Clunky WordPress setups stacked with 40 vulnerable plugins that crash during updates, take 8 seconds to load on mobile, and repel paying customers.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-slate-400 border-t border-white/[0.06]">
            Web Harbor: 0.4s Static Cloudflare Edge Speed
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: The Web Harbor Advantage (Comparison Table) -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <ComparisonTable />
    </div>
  </section>

  <!-- Section 4: Interactive ROI Calculator -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <RoiCalculator />
    </div>
  </section>

  <!-- Section 5: The 3-Step Spec-First Process Preview -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>HOW WE WORK WITH YOU</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.15]">
          From Zero to Live Website in 3 Simple Steps
        </h2>
        <p class="text-slate-400 text-base mt-4">
          No endless wireframe meetings or opaque change orders. Just clear engineering delivered on a live link.
        </p>
      </div>

      <!-- 3 Connected Step Cards with large 01, 02, 03 mono watermarks -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <!-- Step 1 -->
        <div class="spotlight-card relative flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35 overflow-hidden" data-reveal>
          <div class="absolute -top-4 -right-2 text-7xl sm:text-8xl font-mono font-extrabold text-white/[0.04] pointer-events-none select-none">
            01
          </div>
          <div class="space-y-4 relative z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-400/20 text-xs font-mono font-bold">
              STEP 01
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              We Research &amp; Architect
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Tell us your business name and goals. We analyze your local market, competitors, and conversion bottlenecks without wasting your time on 3-hour discovery calls.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-slate-400 font-mono relative z-10 border-t border-white/[0.06]">
            Time: Hours 0–24
          </div>
        </div>

        <!-- Step 2 -->
        <div class="spotlight-card relative flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35 overflow-hidden" data-reveal>
          <div class="absolute -top-4 -right-2 text-7xl sm:text-8xl font-mono font-extrabold text-white/[0.04] pointer-events-none select-none">
            02
          </div>
          <div class="space-y-4 relative z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-400/20 text-xs font-mono font-bold">
              STEP 02
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              We Build Your Live Spec Demo ($0)
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Within 48 to 72 hours, our engineering team builds a working, custom-designed preview hosted on a private staging link so you can test it on your phone and desktop.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-sky-400 font-mono relative z-10 border-t border-white/[0.06]">
            Cost: $0 Upfront
          </div>
        </div>

        <!-- Step 3 -->
        <div class="spotlight-card relative flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35 overflow-hidden" data-reveal>
          <div class="absolute -top-4 -right-2 text-7xl sm:text-8xl font-mono font-extrabold text-white/[0.04] pointer-events-none select-none">
            03
          </div>
          <div class="space-y-4 relative z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-400/20 text-xs font-mono font-bold">
              STEP 03
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              You Decide (Zero Obligation)
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Love it? Pay a $100 setup fee and $99/mo for all-inclusive hosting, domain, and 3 monthly updates. Don't love it? Walk away and pay $0.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-emerald-400 font-mono relative z-10 border-t border-white/[0.06]">
            Flexibility: Month-to-Month
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Industry Blueprint Preview Table -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>CONVERSION BLUEPRINTS</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
          Featured Industry Architecture Blueprints
        </h2>
        <p class="text-slate-400 text-sm sm:text-base mt-2">
          Pre-engineered conversion layouts built for high-ticket local service businesses.
        </p>
      </div>

      <div data-reveal>
        <IndustryBlueprintTable limit={4} showViewAll={true} />
      </div>
    </div>
  </section>

  <!-- Section 7: Bottom Conversion Banner -->
  <CtaBanner />
</BaseLayout>
