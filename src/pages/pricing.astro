---
// src/pages/pricing.astro
// Pricing page strictly adhering to Section 7.6 specifications
import BaseLayout from '../layouts/BaseLayout.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { PRICING_FAQS } from '../data/faqs';

const seoTitle = 'Pricing & Plans | $0 Upfront Demo + $100 Setup + $99/mo | Web Harbor Solutions';
const seoDesc = 'Radical pricing transparency. $0 upfront prototype, $100 one-time setup upon approval, and $99/month for all-inclusive edge hosting, domain, and 3 monthly edits.';
---

<BaseLayout title={seoTitle} description={seoDesc} faqs={PRICING_FAQS}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>RADICAL PRICING TRANSPARENCY</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
          One Simple Plan. Zero Upfront Risk. Zero Surprise Invoices.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Stop paying $5,000 upfront and $150/hour for basic maintenance. Test-drive your custom website live before paying a cent.
        </p>
      </div>
    </div>
  </section>

  <!-- Primary Pricing Architecture (2-Column Featured Layout) -->
  <section class="relative py-12 lg:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        <!-- Card 1: Step 1 - The Live Spec Prototype ($0 Upfront) -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-3xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-8 sm:p-10 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-white/[0.04] text-slate-300 border border-white/10 text-xs font-mono font-bold">
              STEP 1: THE EVALUATION
            </div>

            <div>
              <div class="flex items-baseline gap-2">
                <span class="text-4xl sm:text-5xl font-extrabold text-white font-mono tabular-nums">$0</span>
                <span class="text-slate-400 text-sm font-mono">Today</span>
              </div>
              <h3 class="text-xl font-bold text-white mt-2">The Live Spec Prototype</h3>
              <p class="text-sm text-slate-400 mt-1">
                See your custom website live on a private staging URL before committing.
              </p>
            </div>

            <!-- Bullet Checklist -->
            <ul class="space-y-3 pt-4 border-t border-white/[0.08] text-sm text-slate-300">
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Custom Homepage &amp; Core Layout Preview</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Mobile &amp; Desktop Interactive Link</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>PageSpeed &amp; Conversion Blueprint</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>100% Walk-Away Guarantee if not thrilled</span>
              </li>
            </ul>
          </div>

          <div class="mt-auto pt-8">
            <a
              href="/contact?plan=free-spec-demo"
              class="magnetic-btn w-full py-4 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] border border-white/10 text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all text-center"
            >
              <span>Request Your $0 Spec Demo →</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Step 2 - All-Inclusive Launch & Managed Plan ($100 Setup + $99/mo) -->
        <div class="spotlight-card relative flex flex-col justify-between h-full rounded-3xl bg-slate-900/75 backdrop-blur-xl border-2 border-sky-400/40 p-8 sm:p-10 shadow-2xl transition-all duration-300 hover:border-sky-400" data-reveal>
          <!-- Most Popular Badge -->
          <div class="absolute -top-3.5 right-6 px-3.5 py-1 rounded-full bg-gradient-to-r from-sky-400 to-indigo-500 text-slate-950 text-xs font-mono font-bold uppercase tracking-wider shadow-md">
            MOST POPULAR
          </div>

          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-400/20 text-xs font-mono font-bold">
              STEP 2: FULL LAUNCH &amp; ONGOING CARE
            </div>

            <div>
              <div class="flex items-baseline gap-2">
                <span class="text-4xl sm:text-5xl font-extrabold text-white font-mono tabular-nums">$99</span>
                <span class="text-slate-400 text-sm font-mono">/month</span>
              </div>
              <div class="text-xs font-mono text-emerald-400 font-semibold mt-1">
                + $100 one-time setup (paid only after demo approval)
              </div>
              <h3 class="text-xl font-bold text-white mt-2">All-Inclusive Managed Plan</h3>
              <p class="text-sm text-slate-400 mt-1">
                Complete website launch, enterprise edge hosting, domain, and ongoing care.
              </p>
            </div>

            <!-- Bullet Checklist -->
            <ul class="space-y-3 pt-4 border-t border-white/[0.08] text-sm text-slate-300">
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Complete Multi-Page Custom Website Launch</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Cloudflare Global Edge Hosting ($0 extra)</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Custom Domain Registration or Connection + SSL ($0 extra)</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Up to 3 Content/Design Edits Every Month Included</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>95–100 Mobile PageSpeed Engineering</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Technical SEO, Sitemap &amp; Schema Markup</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>99.9% Uptime SLA &amp; 12-Hour Priority Support</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Cancel Anytime — No Long-Term Lock-In Contracts</span>
              </li>
            </ul>
          </div>

          <div class="mt-auto pt-8">
            <a
              href="/contact?plan=managed-99"
              class="magnetic-btn w-full py-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-xl shadow-sky-500/25 transition-all text-center"
            >
              <span>Claim Your $0 Demo &amp; Lock In $99/mo →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive ROI Calculator Section -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <RoiCalculator />
    </div>
  </section>

  <!-- Full Comparison Matrix Section -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <ComparisonTable />
    </div>
  </section>

  <!-- Pricing FAQ Accordion (6 Questions from src/data/faqs.ts) -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>FREQUENTLY ASKED QUESTIONS</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
          Clear Answers to All Pricing Questions
        </h2>
        <p class="text-slate-400 text-base mt-2">
          No legalese. No hidden clauses. Everything explained in plain English.
        </p>
      </div>

      <div class="space-y-4" data-reveal>
        {PRICING_FAQS.map((faq, idx) => (
          <details class="group rounded-2xl bg-slate-900/55 border border-white/[0.08] p-6 transition-all duration-200 hover:border-sky-400/30 open:bg-slate-900/80">
            <summary class="flex items-center justify-between cursor-pointer list-none text-base sm:text-lg font-semibold text-white">
              <span>{faq.question}</span>
              <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/[0.05] text-slate-400 transition group-open:rotate-180 group-open:text-sky-400">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-white/[0.06] text-sm text-slate-300 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom Conversion Banner -->
  <CtaBanner />
</BaseLayout>
