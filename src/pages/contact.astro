---
// src/pages/contact.astro
// Contact & Claim $0 Live Spec Demo page adhering strictly to Section 6.3 & 7.9
import BaseLayout from '../layouts/BaseLayout.astro';
import { PORTFOLIO_BLUEPRINTS } from '../data/portfolioBlueprints';
import { LEAD_CONFIG } from '../config/leadConfig';

const seoTitle = 'Claim Your $0 Live Spec Demo | Contact Web Harbor Solutions';
const seoDesc = 'Tell us about your business. We will research, design, and code a live custom specification website in 48–72 hours for $0 upfront. Guaranteed response within 12 business hours.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <section class="relative pt-12 pb-24 lg:pt-20 lg:pb-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left 5 Columns: Direct Trust & SLA Summary -->
        <div class="lg:col-span-5 space-y-6" data-reveal>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
            <span>CLAIM YOUR $0 LIVE SPEC DEMO</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Tell Us About Your Business. We'll Build Your Live Demo First.
          </h1>

          <p class="text-base text-slate-300 leading-relaxed">
            No credit card. No discovery calls. No sales pitch. Just give us your business name, and our engineering team will build and host a live staging demo for you to test within 48 to 72 hours.
          </p>

          <!-- Direct Cards -->
          <div class="space-y-4 pt-2">
            <!-- Email Card -->
            <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/[0.08] flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-400/20 flex items-center justify-center text-sky-400 shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="text-xs font-mono uppercase text-slate-400">Direct Inquiries</div>
                <a href="mailto:webharborsolutions@gmail.com" class="text-sm font-semibold text-white hover:text-sky-400 transition-colors">
                  webharborsolutions@gmail.com
                </a>
              </div>
            </div>

            <!-- SLA Card -->
            <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/[0.08] flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-400/20 flex items-center justify-center text-emerald-400 shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <div class="text-xs font-mono uppercase text-slate-400">Guaranteed Response SLA</div>
                <div class="text-sm font-semibold text-white">Within 12 business hours</div>
              </div>
            </div>

            <!-- Prototype Delivery Card -->
            <div class="p-5 rounded-2xl bg-slate-900/60 border border-white/[0.08] flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-400/20 flex items-center justify-center text-indigo-400 shrink-0">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </div>
              <div>
                <div class="text-xs font-mono uppercase text-slate-400">Prototype Delivery</div>
                <div class="text-sm font-semibold text-white">48–72 Hours for Custom Staging Link</div>
              </div>
            </div>
          </div>

          <!-- Zero-Risk Promise Summary -->
          <div class="p-5 rounded-2xl bg-sky-500/[0.06] border border-sky-400/20 space-y-2">
            <div class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400">
              The Web Harbor Commitment
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              $0 Today → $100 One-Time Setup Fee Only If You Love Your Demo → $99/mo All-Inclusive Care. Cancel anytime.
            </p>
          </div>
        </div>

        <!-- Right 7 Columns: Headless Dark-Mode Glassmorphic Form -->
        <div class="lg:col-span-7" data-reveal>
          <div class="spotlight-card rounded-3xl bg-slate-900/70 border border-white/10 p-6 sm:p-10 backdrop-blur-xl shadow-2xl relative overflow-hidden">
            <!-- Dynamic Query Parameter Banner -->
            <div id="query-blueprint-banner" class="hidden mb-6 p-3.5 rounded-xl bg-sky-500/15 border border-sky-400/30 text-xs font-mono text-sky-300 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
              <span id="query-blueprint-text">Selected Blueprint: Custom Spec — $0 Upfront Spec Demo</span>
            </div>

            <!-- Live Form State -->
            <form id="contact-lead-form" class="space-y-5" novalidate>
              <!-- Honeypot anti-spam hidden input -->
              <input type="text" name="bot_field" id="bot_field" class="hidden" tabindex="-1" autocomplete="off" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Full Name -->
                <div>
                  <label for="lead-name" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                    Full Name <span class="text-rose-400">*</span>
                  </label>
                  <input
                    type="text"
                    id="lead-name"
                    name="name"
                    required
                    placeholder="e.g. Dr. Sarah Jenkins"
                    class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-white/10 text-white placeholder-slate-500 text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                  />
                </div>

                <!-- Work Email -->
                <div>
                  <label for="lead-email" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                    Work Email <span class="text-rose-400">*</span>
                  </label>
                  <input
                    type="email"
                    id="lead-email"
                    name="email"
                    required
                    placeholder="sarah@yourpractice.com"
                    class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-white/10 text-white placeholder-slate-500 text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Phone Number -->
                <div>
                  <label for="lead-phone" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                    Phone / WhatsApp Number
                  </label>
                  <input
                    type="tel"
                    id="lead-phone"
                    name="phone"
                    placeholder="(555) 234-5678"
                    class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-white/10 text-white placeholder-slate-500 text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                  />
                </div>

                <!-- Business Name -->
                <div>
                  <label for="lead-businessName" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                    Business Name <span class="text-rose-400">*</span>
                  </label>
                  <input
                    type="text"
                    id="lead-businessName"
                    name="businessName"
                    required
                    placeholder="e.g. Lumina Dental Group"
                    class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-white/10 text-white placeholder-slate-500 text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Current Website URL -->
                <div>
                  <label for="lead-websiteUrl" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                    Current Website URL (if any)
                  </label>
                  <input
                    type="text"
                    id="lead-websiteUrl"
                    name="websiteUrl"
                    placeholder="https://... or 'No website yet'"
                    class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-white/10 text-white placeholder-slate-500 text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                  />
                </div>

                <!-- Industry / Blueprint Select -->
                <div>
                  <label for="lead-niche" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                    Industry / Blueprint <span class="text-rose-400">*</span>
                  </label>
                  <select
                    id="lead-niche"
                    name="niche"
                    required
                    class="w-full px-4 py-3 rounded-xl bg-slate-950/90 border border-white/10 text-white text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                  >
                    <option value="" disabled selected>Select your industry...</option>
                    {PORTFOLIO_BLUEPRINTS.map((bp) => (
                      <option value={bp.slug}>{bp.name} ({bp.specCode})</option>
                    ))}
                    <option value="other">Other Local Service Business</option>
                  </select>
                </div>
              </div>

              <!-- Message / Improvements Needed -->
              <div>
                <label for="lead-message" class="block text-xs font-mono uppercase tracking-wider text-slate-300 mb-2">
                  What would you like improved or included in your demo?
                </label>
                <textarea
                  id="lead-message"
                  name="message"
                  rows="4"
                  placeholder="e.g. We want faster mobile load times, online booking, and a clean modern aesthetic that looks better than our local competitors."
                  class="w-full px-4 py-3 rounded-xl bg-slate-950/60 border border-white/10 text-white placeholder-slate-500 text-sm focus:border-sky-400 focus:outline-hidden transition-colors"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                id="lead-submit-btn"
                class="magnetic-btn w-full py-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-base shadow-lg shadow-sky-500/25 transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Build My Free Live Spec Demo ($0 Upfront) →</span>
              </button>

              <div class="text-center text-xs text-slate-400 font-mono">
                🔒 Zero spam guarantee. We will email your private staging link within 48–72 hours.
              </div>
            </form>

            <!-- Celebratory Dark-Mode Confirmation State (Initially Hidden) -->
            <div id="confirmation-state" class="hidden py-8 space-y-6 text-center">
              <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-400/30 text-emerald-400 flex items-center justify-center mx-auto">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </div>

              <div class="space-y-2">
                <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold">Demo Request Received</span>
                <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                  Your Free Live Spec Demo Is Underway!
                </h3>
                <p class="text-sm text-slate-300 max-w-lg mx-auto leading-relaxed">
                  Our engineering team has received your details. We are conducting market analysis and will email your private Cloudflare staging link within 48–72 hours.
                </p>
              </div>

              <!-- Submitted Details Card -->
              <div class="text-left p-5 rounded-2xl bg-slate-950/80 border border-white/[0.08] max-w-md mx-auto space-y-2 text-xs font-mono">
                <div class="flex justify-between">
                  <span class="text-slate-400">Name:</span>
                  <span id="confirm-name" class="text-white font-semibold"></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400">Business:</span>
                  <span id="confirm-business" class="text-white font-semibold"></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400">Email:</span>
                  <span id="confirm-email" class="text-white font-semibold"></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400">Guaranteed Response:</span>
                  <span class="text-emerald-400 font-semibold">Within 12 business hours</span>
                </div>
              </div>

              <!-- Instant Mailto Backup Button -->
              <div class="pt-2">
                <a
                  id="confirm-mailto-btn"
                  href="mailto:webharborsolutions@gmail.com"
                  class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] border border-white/10 text-white text-xs font-mono transition-colors"
                >
                  <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  <span>Send Instant Copy via Email (webharborsolutions@gmail.com)</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { LEAD_CONFIG } from '../config/leadConfig';

  function initContactPage() {
    const form = document.getElementById('contact-lead-form') as HTMLFormElement | null;
    const confirmationState = document.getElementById('confirmation-state');
    const banner = document.getElementById('query-blueprint-banner');
    const bannerText = document.getElementById('query-blueprint-text');
    const nicheSelect = document.getElementById('lead-niche') as HTMLSelectElement | null;
    const messageInput = document.getElementById('lead-message') as HTMLTextAreaElement | null;

    if (!form || !confirmationState) return;

    // Read URL query parameters (?niche=, ?plan=, ?savings=, ?source=)
    const urlParams = new URLSearchParams(window.location.search);
    const nicheParam = urlParams.get('niche');
    const planParam = urlParams.get('plan');
    const savingsParam = urlParams.get('savings');
    const sourceParam = urlParams.get('source');

    if (nicheParam || planParam || sourceParam) {
      if (banner && bannerText) {
        banner.classList.remove('hidden');
        let label = 'Custom Specification';
        if (nicheParam) label = `Blueprint: ${nicheParam}`;
        else if (planParam) label = `Plan: ${planParam}`;
        else if (sourceParam) label = `Audit Source: ${sourceParam}`;
        bannerText.textContent = `Selected Blueprint: ${label} — $0 Upfront Spec Demo`;
      }

      if (nicheSelect && nicheParam) {
        const option = nicheSelect.querySelector(`option[value="${nicheParam}"]`);
        if (option) {
          nicheSelect.value = nicheParam;
        }
      }

      if (messageInput) {
        if (savingsParam) {
          messageInput.value = `Note: Calculated projected Year 1 savings of $${savingsParam}. Interested in locking in the $99/mo plan.`;
        } else if (sourceParam === 'speed-audit') {
          messageInput.value = `Note: Completed Website Speed & Revenue Leak Audit. Requesting a sub-second 99-PageSpeed demo.`;
        }
      }
    }

    // Form Submission Handling
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot check
      const botField = (document.getElementById('bot_field') as HTMLInputElement)?.value;
      if (botField) return;

      const submitBtn = document.getElementById('lead-submit-btn') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Transmitting Request...</span>';
      }

      const formData = new FormData(form);
      const name = (formData.get('name') as string) || '';
      const email = (formData.get('email') as string) || '';
      const phone = (formData.get('phone') as string) || '';
      const businessName = (formData.get('businessName') as string) || '';
      const websiteUrl = (formData.get('websiteUrl') as string) || '';
      const niche = (formData.get('niche') as string) || '';
      const message = (formData.get('message') as string) || '';

      const payload = {
        name,
        email,
        phone,
        businessName,
        websiteUrl,
        niche,
        message,
        timestamp: new Date().toISOString(),
      };

      // Store in localStorage as failsafe
      try {
        localStorage.setItem('webharbor_last_submission', JSON.stringify(payload));
      } catch (err) {
        // storage disabled, continue
      }

      // Asynchronous dispatch
      try {
        if (LEAD_CONFIG.googleScriptWebhookUrl) {
          const bodyData = new FormData();
          Object.entries(payload).forEach(([k, v]) => bodyData.append(k, v));
          await fetch(LEAD_CONFIG.googleScriptWebhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            body: bodyData,
          });
        } else if (LEAD_CONFIG.googleFormActionUrl) {
          const formBody = new URLSearchParams();
          if (LEAD_CONFIG.googleFormEntries.name) formBody.append(LEAD_CONFIG.googleFormEntries.name, name);
          if (LEAD_CONFIG.googleFormEntries.email) formBody.append(LEAD_CONFIG.googleFormEntries.email, email);
          if (LEAD_CONFIG.googleFormEntries.phone) formBody.append(LEAD_CONFIG.googleFormEntries.phone, phone);
          if (LEAD_CONFIG.googleFormEntries.businessName) formBody.append(LEAD_CONFIG.googleFormEntries.businessName, businessName);
          if (LEAD_CONFIG.googleFormEntries.websiteUrl) formBody.append(LEAD_CONFIG.googleFormEntries.websiteUrl, websiteUrl);
          if (LEAD_CONFIG.googleFormEntries.niche) formBody.append(LEAD_CONFIG.googleFormEntries.niche, niche);
          if (LEAD_CONFIG.googleFormEntries.message) formBody.append(LEAD_CONFIG.googleFormEntries.message, message);

          await fetch(LEAD_CONFIG.googleFormActionUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formBody.toString(),
          });
        }
      } catch (err) {
        console.warn('Asynchronous submission error:', err);
      }

      // Transition to Celebratory Dark Confirmation State
      form.classList.add('hidden');
      confirmationState.classList.remove('hidden');

      const confirmName = document.getElementById('confirm-name');
      const confirmBusiness = document.getElementById('confirm-business');
      const confirmEmail = document.getElementById('confirm-email');
      const mailtoBtn = document.getElementById('confirm-mailto-btn') as HTMLAnchorElement | null;

      if (confirmName) confirmName.textContent = name;
      if (confirmBusiness) confirmBusiness.textContent = businessName;
      if (confirmEmail) confirmEmail.textContent = email;

      if (mailtoBtn) {
        const mailSubject = encodeURIComponent(`🔥 $0 Spec Demo Request: ${businessName} (${name})`);
        const mailBody = encodeURIComponent(
          `Hi Web Harbor Solutions Team,\n\nI just requested a $0 Live Spec Demo:\n\nName: ${name}\nEmail: ${email}\nPhone: ${phone}\nBusiness: ${businessName}\nWebsite: ${websiteUrl}\nIndustry: ${niche}\n\nProject Notes:\n${message}\n\nPlease confirm receipt within 12 business hours!`
        );
        mailtoBtn.href = `mailto:webharborsolutions@gmail.com?subject=${mailSubject}&body=${mailBody}`;
      }
    });
  }

  document.addEventListener('astro:page-load', initContactPage);
</script>
