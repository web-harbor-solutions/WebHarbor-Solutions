---
// src/pages/services.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services & Capabilities | Web Harbor Solutions"
  description="Complete website development, high-speed Cloudflare hosting, security maintenance, and monthly updates for local service businesses."
  canonical="https://webharborsolutions.com/services/"
>
  <!-- Header -->
  <section class="pt-16 pb-12 md:pt-24 md:pb-16 text-center relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-accent-blue/10 text-accent-blue dark:text-blue-400 border border-blue-500/20 mb-6 backdrop-blur-md">
        <span>Turnkey Digital Infrastructure</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-primary-dark dark:text-slate-50 font-display tracking-tight mb-6">
        Everything Your Local Business Needs Online.
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        No surprise hourly invoices or complicated technical maintenance. We bundle custom engineering, lightning-fast edge hosting, and ongoing monthly updates into one simple plan.
      </p>
    </div>
  </section>

  <!-- Core Offering: The Turnkey Website Plan -->
  <section class="py-12 md:py-20 relative z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs uppercase tracking-wider font-bold text-accent-teal dark:text-teal-400 mb-3">The Foundation</h2>
        <p class="text-3xl font-extrabold text-primary-dark dark:text-slate-50 font-display">The Turnkey Website Plan — $99/Month</p>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-3">One predictable monthly retainer covering all your digital bases.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-card backdrop-blur-md transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-950/60 text-accent-blue dark:text-blue-400 flex items-center justify-center mb-6 shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </div>
          <h3 class="text-lg font-bold text-primary-dark dark:text-slate-100 mb-2 font-display">Custom-Coded Development</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Hand-crafted, modern semantic architecture. Zero bloated WordPress themes, zero slow page builders, and zero unnecessary script weight.
          </p>
        </div>

        <!-- Feature 2 -->
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-card backdrop-blur-md transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-teal-100 dark:bg-teal-950/60 text-accent-teal dark:text-teal-400 flex items-center justify-center mb-6 shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-primary-dark dark:text-slate-100 mb-2 font-display">Edge Cloudflare Hosting</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Deployed across Cloudflare’s 300+ city global edge data centers. Sub-second load times, instant DNS resolution, and 99.9% uptime SLA.
          </p>
        </div>

        <!-- Feature 3 -->
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-card backdrop-blur-md transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-6 shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-primary-dark dark:text-slate-100 mb-2 font-display">Domain Registration &amp; SSL</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            One primary custom domain (.com, .net, .org) included annually with automatic renewal and automated SSL encryption certificates.
          </p>
        </div>

        <!-- Feature 4 -->
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-card backdrop-blur-md transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-6 shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-primary-dark dark:text-slate-100 mb-2 font-display">3 Monthly Updates Included</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Swap seasonal promos, adjust business hours, update dispatch phone numbers, or upload fresh project photos with a simple email.
          </p>
        </div>

        <!-- Feature 5 -->
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-card backdrop-blur-md transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-6 shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg>
          </div>
          <h3 class="text-lg font-bold text-primary-dark dark:text-slate-100 mb-2 font-display">Mobile-First Responsiveness</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Over 70% of local service queries come from mobile phones. We engineer click-to-call headers, sticky emergency buttons, and crisp mobile layouts.
          </p>
        </div>

        <!-- Feature 6 -->
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800 shadow-card backdrop-blur-md transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-6 shadow-xs">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <h3 class="text-lg font-bold text-primary-dark dark:text-slate-100 mb-2 font-display">Essential Local SEO Baseline</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            Structured local schema markup, Google Business Profile links, OpenGraph cards, and city-targeted semantic headers built right in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Scope Boundaries: What Is NOT Included -->
  <section class="py-16 bg-white/50 dark:bg-slate-950/40 border-y border-slate-200/80 dark:border-slate-800/80 backdrop-blur-md relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div data-tilt class="p-8 sm:p-10 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-card backdrop-blur-md">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-300">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          </span>
          <h2 class="text-2xl font-bold text-primary-dark dark:text-slate-100 font-display">Transparent Scope Boundaries</h2>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-6">
          To maintain our $99/mo rate without hidden surcharges, we hold firm boundaries on what is covered under the base maintenance retainer:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          <div class="p-4 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 flex items-start gap-2.5">
            <span class="text-red-500 font-bold text-sm">✕</span>
            <span>Complete website overhauls or structural re-architecting</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 flex items-start gap-2.5">
            <span class="text-red-500 font-bold text-sm">✕</span>
            <span>Custom database web apps or multi-vendor eCommerce portals</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 flex items-start gap-2.5">
            <span class="text-red-500 font-bold text-sm">✕</span>
            <span>Paid advertising spend (Google Ads, Meta Ads management)</span>
          </div>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400 italic">
          *Need custom expansions later? We quote those transparently as individual add-ons after your core foundation is live and bringing in leads.
        </p>
      </div>
    </div>
  </section>

  <!-- Optional Post-Launch Add-Ons -->
  <section class="py-16 md:py-24 relative z-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs uppercase tracking-wider font-bold text-accent-blue dark:text-blue-400 mb-3">Growth Accelerators</h2>
        <p class="text-3xl font-extrabold text-primary-dark dark:text-slate-50 font-display">Optional Post-Launch Add-Ons</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-card backdrop-blur-md">
          <h3 class="text-xl font-bold text-primary-dark dark:text-slate-100 mb-3 font-display">Google Business Profile Audit</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
            Category restructuring, secondary trade optimization, service area tuning, and business description optimization to win map-pack rankings.
          </p>
          <span class="inline-block text-xs font-semibold text-accent-blue dark:text-blue-400">Available Post-Launch</span>
        </div>

        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-card backdrop-blur-md">
          <h3 class="text-xl font-bold text-primary-dark dark:text-slate-100 mb-3 font-display">Localized Service Area Pages</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
            Dedicated landing pages targeting neighboring towns, suburbs, and zip codes to capture service calls outside your primary municipality.
          </p>
          <span class="inline-block text-xs font-semibold text-accent-blue dark:text-blue-400">Available Post-Launch</span>
        </div>

        <div data-tilt class="p-8 rounded-3xl bg-white/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 shadow-card backdrop-blur-md">
          <h3 class="text-xl font-bold text-primary-dark dark:text-slate-100 mb-3 font-display">Reputation &amp; Review Funnel</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
            Automated review generation QR codes and SMS follow-up templates designed to guide satisfied customers straight to your Google review link.
          </p>
          <span class="inline-block text-xs font-semibold text-accent-blue dark:text-blue-400">Available Post-Launch</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 md:py-24 bg-primary-dark text-white relative z-10 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-extrabold font-display mb-4">Experience the $99/mo Difference</h2>
      <p class="text-slate-300 text-sm max-w-xl mx-auto mb-8">
        We build your live demo first. You don't commit to a plan until you see your site live in action.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-white bg-accent-blue hover:bg-accent-blue-hover shadow-lg transition duration-200"
      >
        Claim Your Free Spec Demo
      </a>
    </div>
  </section>
</BaseLayout>
