---
// src/pages/liability.astro
// Client Content & Liability Policy strictly adhering to Section 1 & Section 7.10
import BaseLayout from '../layouts/BaseLayout.astro';

const seoTitle = 'Client Content & Liability Agreement | Web Harbor Solutions';
const seoDesc = 'Client content ownership, regulatory compliance guidelines, intellectual property representations, and liability limitations for Web Harbor Solutions.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <main class="py-20 lg:py-28 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto p-8 sm:p-14 rounded-3xl bg-slate-900/60 border border-white/[0.08] shadow-2xl backdrop-blur-xl space-y-10 text-white relative overflow-hidden">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
            <span>LEGAL SAFEGUARDS</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">Client Content &amp; Liability Policy</h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-2 font-mono">Last Updated: October 2026 • Content Integrity &amp; Regulatory Responsibility</p>
        </div>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">1. Client Content Ownership &amp; Warranties</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            The Client warrants that all trademarks, logos, photography, commercial copy, licensing numbers, and service claims supplied or approved for publication on the website are lawfully owned or licensed by the Client. The Client retains all intellectual property rights in their supplied materials.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">2. Industry Regulatory Compliance</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            The Client bears sole legal responsibility for ensuring that all published business claims, pricing structures, medical/health disclaimers, contractor license numbers, legal advertising notices, and trade disclosures adhere to relevant municipal, state, federal, and national trade authorities (e.g. state dental boards, bar associations, medical aesthetic guidelines, or EPA regulations).
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">3. Limitation of Liability</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Web Harbor Solutions operates exclusively as a frontend web engineering and managed edge infrastructure provider. Under no circumstances shall Web Harbor Solutions, its engineering team, or directors be liable for indirect, incidental, or consequential damages resulting from:
          </p>
          <ul class="space-y-2 text-sm sm:text-base text-slate-300 leading-relaxed list-disc list-inside">
            <li>Inaccurate or outdated business pricing, warranty claims, or service disclosures provided by the Client.</li>
            <li>Failure of the Client to maintain active commercial licenses, state permits, or mandated trade insurance.</li>
            <li>Third-party intellectual property infringement claims regarding client-provided logos, images, or copy.</li>
            <li>External upstream registrar or telecom carrier outages outside of Cloudflare's core infrastructure.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">4. Copyright Transfer &amp; License</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Upon activation of the $100 setup fee and active $99/mo subscription, Web Harbor Solutions grants the Client an exclusive, royalty-free commercial license to utilize the compiled frontend design, layouts, and tailored assets for the duration of the website's operation.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">5. Contact &amp; Content Takedown Requests</h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            If you are a trademark owner or consumer reporting a content concern on a domain managed by Web Harbor Solutions, please contact our compliance inbox:
          </p>
          <div class="p-6 rounded-2xl bg-slate-950/70 border border-white/10 text-xs sm:text-sm text-slate-300 space-y-1.5 font-mono">
            <p><strong class="text-white">Web Harbor Solutions Compliance Team</strong></p>
            <p>Direct Email: <a href="mailto:webharborsolutions@gmail.com" class="text-sky-400 hover:underline">webharborsolutions@gmail.com</a></p>
            <p>Guaranteed Triage SLA: Within 12 business hours</p>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
