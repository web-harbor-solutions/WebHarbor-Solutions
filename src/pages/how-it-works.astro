---
// src/pages/how-it-works.astro
// How It Works page strictly adhering to Section 7.4
import BaseLayout from '../layouts/BaseLayout.astro';
import LeakAuditor from '../components/LeakAuditor.astro';
import CtaBanner from '../components/CtaBanner.astro';

const seoTitle = 'How It Works | The Spec-First Engineering Process | Web Harbor Solutions';
const seoDesc = 'No meetings that could have been emails. See how we research, build, and deploy your custom high-speed website for $0 upfront, $100 setup, and $99/mo.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>THE SPEC-FIRST ENGINEERING PROCESS</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
          No meetings that could have been emails. Just pure engineering and execution.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
          We eliminated bloated agency onboarding, endless wireframe revisions, and upfront deposits. Here is the exact timeline from your request to launch.
        </p>

        <div class="pt-2 flex justify-center">
          <a
            href="/contact"
            class="magnetic-btn inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm shadow-xl shadow-sky-500/25 transition-all"
          >
            <span>Start Your 48-Hour Demo ($0 Upfront) →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-Stage Detailed Timeline -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>EXECUTION ROADMAP</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.15]">
          The 4-Stage Engineering Lifecycle
        </h2>
        <p class="text-slate-400 text-base mt-3">
          Every phase is structured to protect your time and eliminate financial risk.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        <!-- Stage 01 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-sky-400 px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-400/20">STAGE 01</span>
              <span class="text-xs font-mono text-slate-400">Hours 0–24</span>
            </div>
            <h3 class="text-lg font-bold text-white tracking-tight">
              Market &amp; Conversion Audit
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Competitor speed analysis, local SEO keyword mapping, and conversion funnel blueprint tailored to your high-ticket service niche.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-slate-400 border-t border-white/[0.06]">
            Deliverable: Architectural Blueprint
          </div>
        </div>

        <!-- Stage 02 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-sky-400 px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-400/20">STAGE 02</span>
              <span class="text-xs font-mono text-slate-400">Hours 24–48</span>
            </div>
            <h3 class="text-lg font-bold text-white tracking-tight">
              The Zero-Dollar Live Prototype
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Custom dark/light niche UI engineering, mobile-first layout, and Cloudflare staging deployment. You get a private link to click and test on your phone.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-emerald-400 border-t border-white/[0.06]">
            Deliverable: Working Private Staging Link
          </div>
        </div>

        <!-- Stage 03 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-sky-400 px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-400/20">STAGE 03</span>
              <span class="text-xs font-mono text-slate-400">Days 3–5</span>
            </div>
            <h3 class="text-lg font-bold text-white tracking-tight">
              Collaborative Refinement &amp; Approval
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              You test the live link on your own devices. We refine copy, branding, and lead forms until you are 100% thrilled. Only then do you pay the $100 setup fee.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-slate-400 border-t border-white/[0.06]">
            Milestone: 100% Client Satisfaction
          </div>
        </div>

        <!-- Stage 04 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-400/20">STAGE 04</span>
              <span class="text-xs font-mono text-slate-400">Day 5–7 &amp; Ongoing</span>
            </div>
            <h3 class="text-lg font-bold text-white tracking-tight">
              Edge Launch &amp; Managed Care
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Custom domain DNS cutover, SSL issuance, Google Search Console indexing, and up to 3 on-demand content/design updates every month on the $99/mo plan.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs font-mono text-sky-400 border-t border-white/[0.06]">
            Commitment: $99/mo (Month-to-Month)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Speed & Revenue Leak Auditor -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <LeakAuditor />
    </div>
  </section>

  <!-- What We Need From You vs. What We Handle (2-Column Contrast Grid) -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>RADICAL SIMPLICITY</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.15]">
          Zero Heavy Lifting on Your End
        </h2>
        <p class="text-slate-400 text-base mt-3">
          You run your business. We engineer and manage your web infrastructure.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        <!-- Left Card: What You Do -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-400/20 text-xs font-mono font-bold">
              YOUR TIME COMMITMENT: ~10 MINUTES
            </div>
            <h3 class="text-2xl font-bold text-white tracking-tight">
              What You Do
            </h3>
            <ul class="space-y-4 text-sm text-slate-300">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-sky-500/10 border border-sky-400/30 text-sky-400 flex items-center justify-center font-mono text-xs shrink-0 mt-0.5">1</span>
                <div>
                  <strong class="text-white block">Submit Your Business Details:</strong>
                  Fill out our 60-second intake form with your business name, existing URL (if any), and goals.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-sky-500/10 border border-sky-400/30 text-sky-400 flex items-center justify-center font-mono text-xs shrink-0 mt-0.5">2</span>
                <div>
                  <strong class="text-white block">Review Your Live Staging Link:</strong>
                  Click the link on your phone and laptop within 48–72 hours to test speed, design, and forms.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-sky-500/10 border border-sky-400/30 text-sky-400 flex items-center justify-center font-mono text-xs shrink-0 mt-0.5">3</span>
                <div>
                  <strong class="text-white block">Approve &amp; Launch:</strong>
                  Give us the green light, pay the $100 setup fee, and tell us which domain to point it to.
                </div>
              </li>
            </ul>
          </div>
          <div class="mt-auto pt-6 text-xs text-slate-400 font-mono border-t border-white/[0.06]">
            Zero technical experience required.
          </div>
        </div>

        <!-- Right Card: What Our Team Handles -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-sky-400/30 p-8 transition-all duration-300 hover:border-sky-400/60" data-reveal>
          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-400/20 text-xs font-mono font-bold">
              100% DONE-FOR-YOU BY WEB HARBOR
            </div>
            <h3 class="text-2xl font-bold text-white tracking-tight">
              What Our Team Handles
            </h3>
            <ul class="space-y-4 text-sm text-slate-300">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <div>
                  <strong class="text-white block">Hand-Crafted Modern Code:</strong>
                  Clean Astro static code compiled for sub-second speeds. No bloated WordPress plugins.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <div>
                  <strong class="text-white block">Responsive Mobile Optimization:</strong>
                  Every button, form, and image is tested and tuned for high mobile conversion rates.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <div>
                  <strong class="text-white block">DNS, SSL &amp; Cloudflare Global Edge:</strong>
                  Zero-downtime DNS cutover, automatic SSL certificate issuance, and global edge CDN caching.
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <div>
                  <strong class="text-white block">Ongoing Monthly Care:</strong>
                  Up to 3 content or design edits every month, uptime monitoring, and security maintenance.
                </div>
              </li>
            </ul>
          </div>
          <div class="mt-auto pt-6 text-xs text-sky-400 font-mono border-t border-white/[0.06]">
            All-inclusive on the $99/mo plan.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Conversion Banner -->
  <CtaBanner />
</BaseLayout>
