---
// src/pages/portfolio.astro
// Portfolio & Industry Blueprints page strictly adhering to Section 7.7
import BaseLayout from '../layouts/BaseLayout.astro';
import IndustryBlueprintTable from '../components/IndustryBlueprintTable.astro';
import CtaBanner from '../components/CtaBanner.astro';

const seoTitle = 'Industry Blueprints & Spec Portfolio | Web Harbor Solutions';
const seoDesc = 'Conversion-engineered web architectures built for high-ticket local businesses. Pick your industry and we will code your custom live demo in 48–72 hours for $0 upfront.';
---

<BaseLayout title={seoTitle} description={seoDesc}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 lg:pt-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>ENGINEERED INDUSTRY BLUEPRINTS</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.08]">
          Conversion-Engineered Architectures Built for High-Ticket Local Businesses.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Explore our production blueprints below. Pick your industry and our team will build a tailored, live specification demo branded for your business in 48–72 hours for $0 upfront.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Industry Blueprint Matrix with Filter Pills -->
  <section class="relative py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
      <IndustryBlueprintTable showFilters={true} />
    </div>
  </section>

  <!-- Architectural Guarantee Section (3 Cards) -->
  <section class="relative py-20 lg:py-28 border-t border-white/[0.08]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-400/20 text-emerald-400 text-xs font-mono uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>CUSTOM SPECIFICATION GUARANTEE</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.15]">
          Every Spec Demo Is 100% Tailored To Your Brand
        </h2>
        <p class="text-slate-400 text-base mt-3">
          We don't send you generic placeholder templates. Here is what goes into your free prototype:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        <!-- Card 1 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-400/20 flex items-center justify-center text-sky-400 font-mono font-bold">
              01
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Bespoke Visual Identity &amp; Photography
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              We extract and refine your exact logo, color palette, staff photography, and past work showcase so your staging link feels entirely custom from day one.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-sky-400 font-mono border-t border-white/[0.06]">
            Branded Color Matching
          </div>
        </div>

        <!-- Card 2 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono font-bold">
              02
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Local Service Area &amp; SEO Mapping
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Your demo includes targeted local service areas, zip code validators, and Google Schema.org structured data aligned with how your clients actually search.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-emerald-400 font-mono border-t border-white/[0.06]">
            Local Intent Optimization
          </div>
        </div>

        <!-- Card 3 -->
        <div class="spotlight-card flex flex-col justify-between h-full rounded-2xl bg-slate-900/55 backdrop-blur-xl border border-white/[0.08] p-6 sm:p-8 transition-all duration-300 hover:border-sky-400/35" data-reveal>
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-mono font-bold">
              03
            </div>
            <h3 class="text-xl font-bold text-white tracking-tight">
              Zero Obligation Test-Drive
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Test every button, form, and animation on your smartphone. If you aren't blown away by the speed and craftsmanship, you pay $0 and we remain friends.
            </p>
          </div>
          <div class="mt-auto pt-6 text-xs text-indigo-400 font-mono border-t border-white/[0.06]">
            $0 Risk Guaranteed
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Conversion Banner -->
  <CtaBanner />
</BaseLayout>
