---
// ThemeToggle.astro
// Animated Light/Dark Mode toggle supporting localStorage, prefers-color-scheme,
// FOUC prevention, and custom 'theme-change' event dispatching for Three.js.
---

<button
  type="button"
  id="theme-toggle-btn"
  class="relative inline-flex items-center justify-center p-2 rounded-xl border border-slate-200 dark:border-slate-700/80 bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700/60 focus:outline-hidden focus:ring-2 focus:ring-accent-blue transition duration-200 shadow-xs group"
  aria-label="Toggle theme"
  title="Toggle dark / light theme"
>
  <!-- Sun Icon (Active in Dark Mode) -->
  <svg
    class="sun-icon w-5 h-5 text-amber-400 transition-all duration-300 transform dark:rotate-0 dark:scale-100 rotate-90 scale-0 hidden dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon Icon (Active in Light Mode) -->
  <svg
    class="moon-icon w-5 h-5 text-slate-700 transition-all duration-300 transform rotate-0 scale-100 dark:-rotate-90 dark:scale-0 block dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const buttons = document.querySelectorAll('#theme-toggle-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const nextTheme = isDark ? 'light' : 'dark';

        if (nextTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        try {
          localStorage.setItem('theme', nextTheme);
        } catch (_) {}

        // Dispatch custom theme-change event with detail for Three.js canvas or other listeners
        window.dispatchEvent(
          new CustomEvent('theme-change', {
            detail: { theme: nextTheme, isDark: nextTheme === 'dark' },
          })
        );
      });
    });
  }

  // Bind on initial page load and every Astro View Transition page load
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
