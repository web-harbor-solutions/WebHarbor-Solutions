---
// src/components/RoiCalculator.astro
// Interactive ROI Calculator adhering strictly to Section 6.1
---

<div class="roi-calculator-root max-w-6xl mx-auto rounded-3xl bg-slate-900/65 border border-white/10 p-6 sm:p-10 backdrop-blur-xl shadow-2xl">
  <!-- Eyebrow & Heading -->
  <div class="text-center max-w-3xl mx-auto mb-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span>REAL-TIME ROI AUDIT</span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
      Traditional Agency Pricing vs. Web Harbor Solutions
    </h2>
    <p class="text-slate-400 text-sm sm:text-base mt-2">
      Adjust your expected upfront quote and ongoing updates to calculate your exact Year 1 net savings.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left 7 Columns (Interactive Sliders) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Slider 1: Traditional Agency Upfront Quote -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08]">
        <div class="flex justify-between items-center mb-3">
          <label for="roi-quote-slider" class="text-sm font-semibold text-white">
            Traditional Agency Upfront Quote
          </label>
          <span class="roi-quote-badge px-3 py-1 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 font-mono font-bold text-base tabular-nums">
            $4,000
          </span>
        </div>
        <input
          type="range"
          id="roi-quote-slider"
          class="roi-quote-slider w-full cursor-pointer accent-sky-400"
          min="1500"
          max="10000"
          step="250"
          value="4000"
        />
        <div class="flex justify-between text-xs font-mono text-slate-500 mt-2">
          <span>$1,500</span>
          <span>$5,000</span>
          <span>$10,000</span>
        </div>
      </div>

      <!-- Slider 2: Monthly Maintenance & Update Hours Needed -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08]">
        <div class="flex justify-between items-center mb-3">
          <label for="roi-hours-slider" class="text-sm font-semibold text-white">
            Monthly Maintenance &amp; Update Hours Needed
          </label>
          <span class="roi-hours-badge px-3 py-1 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 font-mono font-bold text-base tabular-nums">
            2 hrs/mo ($200/mo at $100/hr)
          </span>
        </div>
        <input
          type="range"
          id="roi-hours-slider"
          class="roi-hours-slider w-full cursor-pointer accent-sky-400"
          min="0"
          max="10"
          step="1"
          value="2"
        />
        <div class="flex justify-between text-xs font-mono text-slate-500 mt-2">
          <span>0 hrs ($0/mo)</span>
          <span>5 hrs ($500/mo)</span>
          <span>10 hrs ($1,000/mo)</span>
        </div>
      </div>

      <!-- Visual Cost Comparison Bars -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08] space-y-4">
        <div>
          <div class="flex justify-between text-xs mb-1.5">
            <span class="text-slate-400 font-medium">Traditional 1st Year Cost</span>
            <span class="roi-trad-bar-label text-rose-400 font-mono font-bold tabular-nums">$6,400</span>
          </div>
          <div class="w-full bg-slate-800/80 rounded-full h-2.5 overflow-hidden">
            <div class="roi-trad-bar bg-rose-500 h-2.5 rounded-full transition-all duration-300" style="width: 64%;"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1.5">
            <span class="text-slate-300 font-medium">Web Harbor Solutions 1st Year</span>
            <span class="text-sky-400 font-mono font-bold tabular-nums">$1,288 (Fixed)</span>
          </div>
          <div class="w-full bg-slate-800/80 rounded-full h-2.5 overflow-hidden">
            <div class="roi-wh-bar bg-gradient-to-r from-sky-400 to-emerald-400 h-2.5 rounded-full transition-all duration-300" style="width: 12.88%;"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right 5 Columns (Live Results Card) -->
    <div class="lg:col-span-5">
      <div class="rounded-2xl bg-slate-950/90 border border-white/10 p-6 sm:p-8 flex flex-col justify-between shadow-2xl relative overflow-hidden">
        <div class="space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Financial Audit</span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-mono border border-emerald-500/20">
              Verified Formula
            </span>
          </div>

          <div>
            <div class="text-xs text-slate-400 mb-1">Traditional Agency 1st Year Cost:</div>
            <div class="roi-trad-cost text-2xl font-bold text-rose-400 line-through font-mono tabular-nums">
              $6,400
            </div>
          </div>

          <div>
            <div class="text-xs text-slate-400 mb-1">Web Harbor 1st Year Cost:</div>
            <div class="text-2xl font-bold text-sky-400 font-mono tabular-nums">
              $1,288 <span class="text-xs font-normal text-slate-400 font-sans">($100 setup + $99 × 12)</span>
            </div>
          </div>

          <div class="pt-4 border-t border-white/[0.08]">
            <div class="text-xs uppercase font-mono tracking-wider text-emerald-400 mb-1">Your Year 1 Savings:</div>
            <div class="roi-savings text-4xl sm:text-5xl font-extrabold text-emerald-400 font-mono tabular-nums tracking-tight">
              $5,112
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/[0.08]">
          <a
            href="/contact?plan=standard-99&savings=5112"
            class="roi-cta-btn magnetic-btn w-full py-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-lg shadow-sky-500/25 transition-all text-center"
          >
            <span class="roi-cta-text">Lock In Your $99/mo Plan &amp; Save $5,112 →</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initRoiCalculators() {
    const roots = document.querySelectorAll<HTMLElement>('.roi-calculator-root');

    roots.forEach((root) => {
      const quoteSlider = root.querySelector<HTMLInputElement>('.roi-quote-slider');
      const hoursSlider = root.querySelector<HTMLInputElement>('.roi-hours-slider');
      const quoteBadge = root.querySelector<HTMLElement>('.roi-quote-badge');
      const hoursBadge = root.querySelector<HTMLElement>('.roi-hours-badge');
      const tradCostEl = root.querySelector<HTMLElement>('.roi-trad-cost');
      const savingsEl = root.querySelector<HTMLElement>('.roi-savings');
      const tradBar = root.querySelector<HTMLElement>('.roi-trad-bar');
      const tradBarLabel = root.querySelector<HTMLElement>('.roi-trad-bar-label');
      const ctaBtn = root.querySelector<HTMLAnchorElement>('.roi-cta-btn');
      const ctaText = root.querySelector<HTMLElement>('.roi-cta-text');

      if (!quoteSlider || !hoursSlider || !quoteBadge || !hoursBadge || !tradCostEl || !savingsEl || !ctaBtn || !ctaText) {
        return;
      }

      function updateCalculation() {
        const quote = parseInt(quoteSlider!.value, 10);
        const hours = parseInt(hoursSlider!.value, 10);

        // Update labels
        quoteBadge!.textContent = `$${quote.toLocaleString()}`;
        hoursBadge!.textContent = `${hours} hrs/mo ($${(hours * 100).toLocaleString()}/mo at $100/hr agency rate)`;

        // Exact Mathematical Formulas (Section 6.1)
        const tradCost = quote + hours * 100 * 12;
        const webHarborCost = 100 + 99 * 12; // $1,288
        const savings = tradCost - webHarborCost;

        tradCostEl!.textContent = `$${tradCost.toLocaleString()}`;
        savingsEl!.textContent = `$${savings.toLocaleString()}`;

        if (tradBar) {
          const maxScale = 22000;
          const pct = Math.min(100, Math.max(10, (tradCost / maxScale) * 100));
          tradBar.style.width = `${pct}%`;
        }
        if (tradBarLabel) {
          tradBarLabel.textContent = `$${tradCost.toLocaleString()}`;
        }

        // Update CTA Link and Label
        ctaBtn!.href = `/contact?plan=standard-99&savings=${savings}`;
        ctaText!.textContent = `Lock In Your $99/mo Plan & Save $${savings.toLocaleString()} →`;
      }

      quoteSlider.addEventListener('input', updateCalculation);
      hoursSlider.addEventListener('input', updateCalculation);

      // Run on init
      updateCalculation();
    });
  }

  document.addEventListener('astro:page-load', initRoiCalculators);
</script>
