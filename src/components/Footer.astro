---
// src/components/Footer.astro
// Global footer adhering strictly to Section 7.2 brand and compliance standards

const navigationLinks = [
  { label: 'Home', href: '/' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Services', href: '/services' },
  { label: 'Pricing & Plans', href: '/pricing' },
  { label: 'Live Portfolio', href: '/portfolio' },
  { label: 'About Us', href: '/about' },
  { label: 'Contact Us', href: '/contact' },
];

const coreBlueprints = [
  { label: 'Dental & Orthodontics', href: '/portfolio#dental-clinic' },
  { label: 'HVAC, Plumbing & Electrical', href: '/portfolio#hvac-plumbing' },
  { label: 'Personal Injury & Law Firms', href: '/portfolio#law-firm' },
  { label: 'Luxury Real Estate', href: '/portfolio#luxury-real-estate' },
  { label: 'MedSpa & Aesthetics', href: '/portfolio#medspa' },
  { label: 'Ceramic Coating & Auto Spa', href: '/portfolio#auto-detailing' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms of Service & SLA', href: '/terms' },
  { label: 'Client Content & Liability', href: '/liability' },
];
---

<footer class="relative z-10 bg-[#05070e] border-t border-white/[0.08] text-slate-300 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Trust Bar (3 Badges) -->
    <div class="flex flex-wrap items-center justify-center sm:justify-between gap-4 pb-12 border-b border-white/[0.08]">
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-slate-900/60 border border-white/[0.08] text-xs font-medium text-slate-200">
        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
        <span>Cloudflare Global Edge Hosted</span>
      </div>
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-slate-900/60 border border-white/[0.08] text-xs font-medium text-slate-200">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>99.9% Uptime & Security SLA</span>
      </div>
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-xl bg-slate-900/60 border border-white/[0.08] text-xs font-medium text-slate-200">
        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
        <span>100% Free Live Spec Demo</span>
      </div>
    </div>

    <!-- 4-Column Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 py-12">
      <!-- Col 1: Brand & Philosophy -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3 group" aria-label="Web Harbor Solutions Home">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center p-2 shadow-md shadow-sky-500/20">
            <svg class="w-full h-full text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
              <path d="M12 2L21 7V17L12 22L3 17V7L12 2Z"></path>
              <path d="M12 2V12L21 17"></path>
              <path d="M12 12L3 17"></path>
              <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
            </svg>
          </div>
          <div class="flex flex-col leading-tight">
            <span class="font-bold text-white tracking-tight text-base">Web Harbor</span>
            <span class="text-[9px] font-mono uppercase tracking-widest text-sky-400 font-semibold">SOLUTIONS</span>
          </div>
        </a>

        <p class="text-xs text-slate-400 leading-relaxed">
          The Zero-Risk Web Engineering Agency. We build your complete, custom high-speed website first. You only pay if you love it.
        </p>

        <div class="pt-2 space-y-1.5 text-xs">
          <div class="text-slate-400">
            <span class="text-slate-200 font-medium">Direct Email:</span>{' '}
            <a href="mailto:webharborsolutions@gmail.com" class="text-sky-400 hover:text-sky-300 transition-colors">
              webharborsolutions@gmail.com
            </a>
          </div>
          <div class="text-slate-400">
            <span class="text-slate-200 font-medium">Guaranteed Response:</span> Within 12 business hours.
          </div>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold mb-4">Navigation</h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          {navigationLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Core Blueprints -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold mb-4">Core Blueprints</h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          {coreBlueprints.map((blueprint) => (
            <li>
              <a href={blueprint.href} class="hover:text-white transition-colors flex items-center gap-1.5">
                <span class="w-1 h-1 rounded-full bg-sky-400"></span>
                <span>{blueprint.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal & SLA -->
      <div>
        <h3 class="text-xs font-mono uppercase tracking-widest text-sky-400 font-semibold mb-4">Legal &amp; SLA</h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 p-3.5 rounded-xl bg-slate-900/60 border border-white/[0.08] text-[11px] text-slate-400 leading-relaxed">
          Zero upfront contracts. Built on private staging before any invoice is issued.
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="pt-8 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; 2026 Web Harbor Solutions. All rights reserved. Engineered on Edge Static Architecture.</p>
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span class="text-slate-400">All edge systems operational</span>
      </div>
    </div>
  </div>
</footer>
