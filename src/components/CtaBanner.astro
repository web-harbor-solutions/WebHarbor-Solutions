---
// src/components/CtaBanner.astro
// Universal high-conversion bottom banner for Web Harbor Solutions

interface Props {
  headline?: string;
  subheadline?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  headline = 'Ready to see what your business looks like with a modern, 99-PageSpeed website?',
  subheadline = 'Our team will build and send you a live working demo link before you spend a dime.',
  buttonText = 'Claim Your Free Spec Demo Now →',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="relative py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="spotlight-card rounded-3xl bg-gradient-to-b from-slate-900/80 to-slate-950/90 border border-sky-400/20 p-8 sm:p-14 text-center backdrop-blur-xl shadow-2xl relative overflow-hidden">
      <!-- Glow Accents -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-sky-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-400/20 text-sky-400 text-xs font-mono uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
          <span>100% RISK-FREE SPEC DEMO</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {headline}
        </h2>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
          {subheadline}
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={buttonHref}
            class="magnetic-btn inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-base shadow-xl shadow-sky-500/25 transition-all w-full sm:w-auto"
          >
            <span>{buttonText}</span>
          </a>
          <a
            href="/portfolio"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-white font-semibold text-base transition-all w-full sm:w-auto"
          >
            <span>Explore Blueprints</span>
          </a>
        </div>

        <div class="pt-6 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400 font-mono">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>$0 Upfront Investment</span>
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>48–72h Staging Delivery</span>
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>No Obligation to Launch</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
