---
// src/components/Navbar.astro
// Sticky Glass Header with brand beacon, route highlighting, magnetic CTA, and mobile drawer

const pathname = Astro.url.pathname;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Services', href: '/services' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'About Us', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
};
---

<header class="fixed top-0 inset-x-0 z-50 bg-[#05070e]/80 backdrop-blur-xl border-b border-white/[0.07]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo Mark & Name -->
    <a href="/" class="flex items-center gap-3 group" aria-label="Web Harbor Solutions Home">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center p-2 shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform duration-200">
        <!-- SVG Geometric Harbor Beacon / Wireframe Cube -->
        <svg class="w-full h-full text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round">
          <path d="M12 2L21 7V17L12 22L3 17V7L12 2Z"></path>
          <path d="M12 2V12L21 17"></path>
          <path d="M12 12L3 17"></path>
          <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
        </svg>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="font-bold text-white tracking-tight text-lg group-hover:text-sky-300 transition-colors">Web Harbor</span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-sky-400 font-semibold">SOLUTIONS</span>
      </div>
    </a>

    <!-- Center Desktop Links -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Desktop Navigation">
      {navLinks.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-xl text-sm font-medium transition-colors ${
              active
                ? 'text-white bg-white/[0.06] border border-white/10 font-semibold shadow-xs'
                : 'text-slate-300 hover:text-white hover:bg-white/[0.03]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Magnetic CTA & Mobile Hamburger -->
    <div class="flex items-center gap-4">
      <a
        href="/contact"
        class="magnetic-btn hidden sm:inline-flex items-center gap-2 bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-xl shadow-lg shadow-sky-500/20 transition-all duration-200"
      >
        <span>Claim Free Demo</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-2.5 rounded-xl border border-white/10 text-slate-300 hover:text-white hover:bg-white/[0.05] transition-colors"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div
    id="mobile-menu-panel"
    class="hidden lg:hidden border-t border-white/[0.07] bg-[#05070e]/95 backdrop-blur-2xl px-4 py-5 space-y-2"
  >
    {navLinks.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class={`block px-4 py-2.5 rounded-xl text-base font-medium transition-colors ${
            active
              ? 'bg-sky-500/15 text-sky-400 font-semibold border border-sky-400/20'
              : 'text-slate-300 hover:text-white hover:bg-white/[0.04]'
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <div class="pt-3 border-t border-white/[0.07]">
      <a
        href="/contact"
        class="w-full flex items-center justify-center gap-2 bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm px-4 py-3 rounded-xl shadow-lg shadow-sky-500/20 transition-all"
      >
        <span>Claim Free Demo</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<!-- Header Spacer so top content isn't obscured -->
<div class="h-20" aria-hidden="true"></div>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-btn');
    const panel = document.getElementById('mobile-menu-panel');
    const burgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!btn || !panel) return;

    // Remove existing event listener if any (clean rebind)
    const newBtn = btn.cloneNode(true) as HTMLElement;
    btn.parentNode?.replaceChild(newBtn, btn);

    const updatedBurger = document.getElementById('hamburger-icon');
    const updatedClose = document.getElementById('close-icon');

    newBtn.addEventListener('click', () => {
      const isHidden = panel.classList.contains('hidden');
      if (isHidden) {
        panel.classList.remove('hidden');
        newBtn.setAttribute('aria-expanded', 'true');
        updatedBurger?.classList.add('hidden');
        updatedClose?.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
        newBtn.setAttribute('aria-expanded', 'false');
        updatedBurger?.classList.remove('hidden');
        updatedClose?.classList.add('hidden');
      }
    });

    // Close mobile menu on link click
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        panel.classList.add('hidden');
        newBtn.setAttribute('aria-expanded', 'false');
        updatedBurger?.classList.remove('hidden');
        updatedClose?.classList.add('hidden');
      });
    });
  }

  document.addEventListener('astro:page-load', setupNavbar);
</script>
