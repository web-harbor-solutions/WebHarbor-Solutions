---
// src/components/Canvas3D.astro
// Persistent full-viewport Three.js background canvas
---

<div
  id="webgl-container"
  transition:persist="webgl-canvas"
  class="fixed inset-0 -z-10 pointer-events-none overflow-hidden bg-[#05070e]"
  aria-hidden="true"
></div>

<script>
  import * as THREE from 'three';

  declare global {
    interface Window {
      __webHarbor3DInitialized?: boolean;
    }
  }

  function initThreeScene() {
    if (window.__webHarbor3DInitialized) return;

    const container = document.getElementById('webgl-container');
    if (!container) return;

    window.__webHarbor3DInitialized = true;

    const isMobile =
      window.innerWidth < 768 ||
      (typeof navigator !== 'undefined' &&
        !!navigator.hardwareConcurrency &&
        navigator.hardwareConcurrency <= 4);

    // 1. Scene & Fog
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x05070e, 0.032);

    // 2. Camera
    let width = window.innerWidth;
    let height = window.innerHeight;
    const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 100);
    camera.position.set(0, 0, 8);

    // 3. Renderer
    const renderer = new THREE.WebGLRenderer({
      alpha: true,
      antialias: !isMobile,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setClearColor(0x05070e, 1);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.2 : 1.75));
    container.appendChild(renderer.domElement);

    // 4. Geometry Group (coreGroup)
    const coreGroup = new THREE.Group();
    coreGroup.position.set(isMobile ? 0 : 1.8, 0, 0);
    scene.add(coreGroup);

    // Outer Wireframe Mesh (Icosahedron)
    const outerGeo = new THREE.IcosahedronGeometry(4.2, isMobile ? 1 : 2);
    const outerMat = new THREE.MeshBasicMaterial({
      color: 0x38bdf8,
      wireframe: true,
      transparent: true,
      opacity: 0.16,
      blending: THREE.AdditiveBlending,
    });
    const outerMesh = new THREE.Mesh(outerGeo, outerMat);
    coreGroup.add(outerMesh);

    // Inner Morphing Torus Knot Core
    const innerGeo = new THREE.TorusKnotGeometry(
      1.8,
      0.45,
      isMobile ? 64 : 100,
      isMobile ? 12 : 16
    );
    const innerMat = new THREE.MeshBasicMaterial({
      color: 0x6366f1,
      wireframe: true,
      transparent: true,
      opacity: 0.12,
      blending: THREE.AdditiveBlending,
    });
    const innerMesh = new THREE.Mesh(innerGeo, innerMat);
    coreGroup.add(innerMesh);

    // 5. Spatial Edge Particle Field (particleSystem)
    const particleCount = isMobile ? 220 : 800;
    const particlePositions = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i++) {
      const idx = i * 3;
      const radius = 5 + Math.random() * 12;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      particlePositions[idx] = radius * Math.sin(phi) * Math.cos(theta);
      particlePositions[idx + 1] = radius * Math.sin(phi) * Math.sin(theta);
      particlePositions[idx + 2] = radius * Math.cos(phi);
    }

    const particleGeo = new THREE.BufferGeometry();
    particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));

    const particleMat = new THREE.PointsMaterial({
      color: 0x38bdf8,
      size: 0.045,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
    });
    const particleSystem = new THREE.Points(particleGeo, particleMat);
    scene.add(particleSystem);

    // Mouse Tracking
    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;

    if (!isMobile) {
      window.addEventListener(
        'mousemove',
        (e) => {
          targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
          targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
        },
        { passive: true }
      );
    }

    // Window Resize Handler
    const handleResize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };
    window.addEventListener('resize', handleResize);

    // Scroll Progress Calculation
    let targetScrollProgress = 0;
    let currentScrollProgress = 0;

    const updateScrollTarget = () => {
      const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
      targetScrollProgress = totalScroll > 0 ? window.scrollY / totalScroll : 0;
    };
    window.addEventListener('scroll', updateScrollTarget, { passive: true });
    updateScrollTarget();

    // 6. Animation Loop with Lerp & Visibility Throttling
    let clock = new THREE.Clock();

    function animate() {
      if (!document.hidden) {
        const elapsedTime = clock.getElapsedTime();

        // Smooth scroll interpolation
        currentScrollProgress += (targetScrollProgress - currentScrollProgress) * 0.08;

        // Smooth mouse interpolation
        currentMouseX += (targetMouseX - currentMouseX) * 0.05;
        currentMouseY += (targetMouseY - currentMouseY) * 0.05;

        // Continuous Rotation + Scroll Progress
        coreGroup.rotation.y = elapsedTime * 0.18 + currentScrollProgress * Math.PI * 2;
        coreGroup.rotation.x = Math.sin(elapsedTime * 0.25) * 0.2 + currentScrollProgress * 0.5;

        innerMesh.rotation.x = elapsedTime * 0.35;
        innerMesh.rotation.y = elapsedTime * 0.25;

        // Subtle desktop tilt toward cursor
        if (!isMobile) {
          coreGroup.rotation.y += currentMouseX * 0.25;
          coreGroup.rotation.x += -currentMouseY * 0.25;
        }

        // Camera Depth Morph: shifts smoothly between 9 and 6.5
        camera.position.z = 8.5 - currentScrollProgress * 2.0;

        // Morph Core Group vertical drift and scale
        coreGroup.position.y = -currentScrollProgress * 2.2;
        const scaleFactor = 1.0 - currentScrollProgress * 0.15;
        coreGroup.scale.set(scaleFactor, scaleFactor, scaleFactor);

        // Particle System Slow Orbital Drift
        particleSystem.rotation.y = elapsedTime * 0.04;
        particleSystem.rotation.x = elapsedTime * 0.02;

        renderer.render(scene, camera);
      }

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }

  function scheduleInit() {
    if (typeof window === 'undefined') return;
    if (window.__webHarbor3DInitialized) return;

    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => initThreeScene(), { timeout: 120 });
    } else {
      setTimeout(() => initThreeScene(), 120);
    }
  }

  document.addEventListener('astro:page-load', () => {
    scheduleInit();
  });
</script>
